{
  "title": "Gold Price Prediction Dashboard",
  "uid": "gold-prediction",
  "version": 1,
  "tags": ["gold", "prediction"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Predicted Gold Price",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "format": "table",
          "rawSql": "SELECT timestamp, predicted_price FROM predictions ORDER BY timestamp DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Prediction History",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "format": "time_series",
          "rawSql": "SELECT timestamp, predicted_price FROM predictions ORDER BY timestamp",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "id": 3,
      "title": "Model Metrics",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "format": "table",
          "rawSql": "SELECT timestamp, model_name, ROUND(mae::numeric, 4) as mae, ROUND(rmse::numeric, 4) as rmse, ROUND(r2::numeric, 4) as r2 FROM model_metrics ORDER BY timestamp DESC LIMIT 10",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recent Predictions",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "PostgreSQL" },
          "format": "table",
          "rawSql": "SELECT timestamp, ROUND(predicted_price::numeric, 2) as predicted, ROUND(actual_price::numeric, 2) as actual, model_version FROM predictions ORDER BY timestamp DESC LIMIT 50",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39
}
