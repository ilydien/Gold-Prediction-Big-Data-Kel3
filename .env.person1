# ============================================
# Person 1: Yoeke — Data Ingestion
# Salin file ini menjadi .env lalu isi IP Tailscale
# ============================================

# Service di laptop Yoeke sendiri
KAFKA_BROKER=0.0.0.0:9092
KAFKA_ADVERTISED_LISTENER=100.x.x.1:9092

# Remote: Dio (Person 2) — Spark
# (tidak perlu config untuk Spark, Dio yang connect ke Kafka kamu)

# Remote: Fatih (Person 3) — Garage
GARAGE_ENDPOINT=http://100.x.x.3:3900
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# Remote: Angel (Person 4) — PostgreSQL
POSTGRES_HOST=100.x.x.4
POSTGRES_PORT=5432
POSTGRES_DB=gold_prediction
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
